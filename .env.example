# From https://app.dnotifier.com (your app's App ID and Secret)
DNOTIFIER_APP_ID=your-app-id-here
DNOTIFIER_SECRET=your-app-secret-here
DNOTIFIER_USER_ID=founderslens-system

# AI model (matches DNotifier's OpenAI integration). Change only if you use another provider.
DNOTIFIER_AI_PROVIDER=open_ai
DNOTIFIER_AI_MODEL=gpt-4o

# Optional
FLASK_SECRET_KEY=change-me
PORT=5000
